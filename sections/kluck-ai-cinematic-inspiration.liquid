{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{% assign store_gen = shop.metafields.kluck_ai.store_generation.value %}
{% assign home = store_gen.home_page %}
{% assign ht = home.text %}
{% assign use_mf = section.settings.use_kluck_ai_metafields %}
{% assign homeData = section.settings.homeData %}
{% if ht == blank and homeData.text != blank %}{% assign ht = homeData.text %}{% endif %}

{% assign inspiration_line_1 = section.settings.inspiration_line_1 %}
{% assign inspiration_line_1_accent = section.settings.inspiration_line_1_accent %}
{% assign inspiration_line_2 = section.settings.inspiration_line_2 %}
{% if use_mf %}
  {% if ht.inspiration_line_1 != blank %}{% assign inspiration_line_1 = ht.inspiration_line_1 %}{% endif %}
  {% if ht.inspiration_line_1_accent != blank %}{% assign inspiration_line_1_accent = ht.inspiration_line_1_accent %}{% endif %}
  {% if ht.inspiration_line_2 != blank %}{% assign inspiration_line_2 = ht.inspiration_line_2 %}{% endif %}
{% endif %}

{% if shop.metafields.app.block_control.value %}
<style>
  #shopify-section-{{ section.id }} {
    width: 100%;
    max-width: none;
  }
    #ci-{{ section.id }} {
  --c-ink: var(--color-on-accent, #fff);
  --c-ink-muted: var(--color-on-accent-muted, rgba(255,255,255,0.55));
  --c-surface: var(--color-accent, var(--color-primary-button-background, #111));
  --c-accent: var(--color-accent, var(--color-primary-button-background, currentColor));
  --c-accent-soft: var(--color-accent-soft, rgba(255,255,255,0.2));
  --c-on-accent: var(--color-on-accent, #fff);
  --c-border: color-mix(in srgb, var(--c-on-accent) 20%, transparent);
  --c-heading-font: var(--section-heading-font, Georgia, 'Times New Roman', serif);
  --c-body-font: var(--section-body-font, system-ui, sans-serif);  background: var(--c-surface); }
  #ci-{{ section.id }} .ci-inner { max-width: 960px; margin: 0 auto; padding: 32px 24px; text-align: center; }
  #ci-{{ section.id }} .ci-line1 {
    margin: 0; font-family: var(--c-heading-font); font-style: italic; font-size: 1.875rem;
    line-height: 1.3; color: var(--c-ink); font-weight: 400;
  }
  #ci-{{ section.id }} .ci-accent { color: var(--c-ink); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--c-ink) 45%, transparent); text-underline-offset: 0.18em; }
  #ci-{{ section.id }} .ci-line2 {
    margin: 12px auto 0; max-width: 720px; font-family: var(--c-heading-font); font-style: italic;
    font-size: 1.25rem; line-height: 1.6; color: var(--c-ink-muted); font-weight: 400;
  }
  @media (min-width: 768px) {
    #ci-{{ section.id }} .ci-inner { padding: 40px 24px; }
    #ci-{{ section.id }} .ci-line1 { font-size: 3rem; }
    #ci-{{ section.id }} .ci-line2 { font-size: 1.5rem; }
  }
</style>
<section id="ci-{{ section.id }}" class="color-{{ section_scheme }}">
  <div class="ci-inner">
    {% if inspiration_line_1 != blank or inspiration_line_1_accent != blank %}
      <p class="ci-line1">{{ inspiration_line_1 }}{% if inspiration_line_1_accent != blank %} <span class="ci-accent">{{ inspiration_line_1_accent }}</span>{% endif %}</p>
    {% endif %}
    {% if inspiration_line_2 != blank %}<p class="ci-line2">{{ inspiration_line_2 }}</p>{% endif %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Kluck AI - Cin Inspire",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_kluck_ai_metafields",
      "label": "Use Kluck AI metafields",
      "default": true
    },
    {
      "type": "text",
      "id": "inspiration_line_1",
      "label": "Line 1",
      "default": "Small earbuds."
    },
    {
      "type": "text",
      "id": "inspiration_line_1_accent",
      "label": "Line 1 accent",
      "default": "Big possibilities."
    },
    {
      "type": "textarea",
      "id": "inspiration_line_2",
      "label": "Line 2",
      "default": "Sound that moves with you — for a brighter everyday."
    }
  ],
  "presets": [
    {
      "name": "Kluck AI - Cin Inspire"
    }
  ]
}
{% endschema %}
