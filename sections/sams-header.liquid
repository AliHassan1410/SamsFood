{%- comment -%}
  Sam's Food - Editorial Custom Header
  Matches screenshot:
  - Orange circular logo badge + bold italic "Sam's" wordmark
  - Inline navigation: Shop · Bundles · Recipes · Wholesale · About
  - Right actions: Search, WhatsApp quick-link, and Cart with live count badge
  - Mobile drawer navigation
{%- endcomment -%}

<header
  id="sams-site-header"
  class="sams-header-wrapper"
  style="background: {{ section.settings.bg_color | default: '#FAF4EA' }}; border-bottom: 1px solid {{ section.settings.border_color | default: '#EADBCA' }}; position: sticky; top: 0; z-index: 100; transition: box-shadow 0.25s ease;"
>
  <div style="max-width: 1280px; margin: 0 auto; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
    
    <!-- Left: Logo + Desktop Menu in one clean line -->
    <div style="display: flex; align-items: center; gap: 40px; min-width: 0;">
      <!-- Brand Logo -->
      <a
        href="{{ routes.root_url }}"
        class="sams-brand-logo"
        style="display: inline-flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0;"
        aria-label="Sam's Food Home"
      >
        <!-- Orange circular brand badge -->
        <div
          class="sams-logo-badge"
          style="width: 44px; height: 44px; border-radius: 50%; background: #E87722; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 8px rgba(232, 119, 34, 0.25);"
        >
          <svg width="26" height="26" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- White top rim of bowl / pita -->
            <path d="M8 20 C8 13 32 13 32 20 C32 27 8 27 8 20 Z" fill="#FFFFFF"/>
            <!-- Dark dip / interior curve -->
            <path d="M12 20.5 C12 24.5 28 24.5 28 20.5 C27 25 24 26 20 26 C16 26 13 25 12 20.5 Z" fill="#2B160E"/>
          </svg>
        </div>

        <!-- Sam's bold italic wordmark -->
        <span
          class="sams-logo-text"
          style="font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 800; font-size: 29px; color: #2B160E; letter-spacing: -0.6px; line-height: 1;"
        >
          Sam's
        </span>
      </a>

      <!-- Desktop Navigation Menu (matches screenshot) -->
      <nav class="sams-desktop-nav" aria-label="Main Navigation">
        <ul style="display: flex; align-items: center; gap: 32px; list-style: none; margin: 0; padding: 0;">
          <li>
            <a href="/collections/all" class="sams-nav-link">Shop</a>
          </li>
          <li>
            <a href="/pages/bundles" class="sams-nav-link">Bundles</a>
          </li>
          <li>
            <a href="/pages/recipes" class="sams-nav-link">Recipes</a>
          </li>
          <li>
            <a href="/collections/bulk-wholesale" class="sams-nav-link">Wholesale</a>
          </li>
          <li>
            <a href="/pages/about" class="sams-nav-link">About</a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Right: Search, WhatsApp & Cart Actions -->
    <div style="display: flex; align-items: center; gap: 16px; flex-shrink: 0;">
      <!-- Search Icon Button -->
      <a
        href="{{ routes.search_url }}"
        class="sams-header-icon-btn"
        aria-label="Search products"
        title="Search"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Cart Icon with Live Bubble -->
      <a
        href="{{ routes.cart_url }}"
        class="sams-header-cart-btn"
        id="sams-header-cart-link"
        aria-label="View Cart"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span
          class="sams-cart-count-badge"
          id="sams-cart-count"
          style="{% if cart.item_count == 0 %}display: none;{% endif %}"
        >
          {{ cart.item_count }}
        </span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        class="sams-mobile-toggle"
        id="sams-mobile-menu-btn"
        aria-label="Open mobile menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="sams-mobile-drawer" class="sams-mobile-drawer" aria-hidden="true">
    <div class="sams-mobile-drawer__overlay" id="sams-drawer-overlay"></div>
    <div class="sams-mobile-drawer__content">
      <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 20px; border-bottom: 1px solid var(--line); margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; border-radius: 50%; background: #E87722; display: flex; align-items: center; justify-content: center;">
            <svg width="20" height="20" viewBox="0 0 40 40" fill="none">
              <path d="M8 20 C8 13 32 13 32 20 C32 27 8 27 8 20 Z" fill="#FFFFFF"/>
              <path d="M12 20.5 C12 24.5 28 24.5 28 20.5 C27 25 24 26 20 26 C16 26 13 25 12 20.5 Z" fill="#2B160E"/>
            </svg>
          </div>
          <span style="font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 800; font-size: 24px; color: #2B160E;">Sam's</span>
        </div>
        <button type="button" id="sams-drawer-close" style="background: none; border: none; font-size: 24px; color: #2B160E; cursor: pointer; padding: 4px;">&times;</button>
      </div>

      <nav style="display: flex; flex-direction: column; gap: 18px;">
        <a href="/collections/all" class="sams-mobile-nav-link">Shop</a>
        <a href="/pages/bundles" class="sams-mobile-nav-link">Bundles</a>
        <a href="/pages/recipes" class="sams-mobile-nav-link">Recipes</a>
        <a href="/collections/bulk-wholesale" class="sams-mobile-nav-link">Wholesale</a>
        <a href="/pages/about" class="sams-mobile-nav-link">About</a>
      </nav>

      <div style="margin-top: auto; padding-top: 30px; border-top: 1px solid var(--line);">
        <a
          href="https://wa.me/923454788888?text=Hi%20Sam%27s%20Food!%20I%20would%20like%20to%20order."
          target="_blank"
          rel="noopener noreferrer"
          class="sams-btn-whatsapp"
          style="width: 100%; justify-content: center;"
        >
          Order via WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Pin the announcement bar and header together; the header's own wrapper is only as tall as the header, so sticky must sit on the group */
  #header-group {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* Keep anchor targets (e.g. #sams-build-box) clear of the pinned header */
  html,
  .page-wrapper {
    scroll-padding-top: 110px;
  }

  /* Header styling matching user screenshot */
  .sams-nav-link {
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #2B160E;
    text-decoration: none;
    transition: color 0.18s ease;
    padding: 6px 0;
    position: relative;
  }

  .sams-nav-link:hover {
    color: #C45500;
  }

  .sams-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: #E87722;
    transition: width 0.22s ease;
  }

  .sams-nav-link:hover::after {
    width: 100%;
  }

  .sams-header-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #2B160E;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .sams-header-icon-btn:hover {
    background: rgba(43, 22, 14, 0.06);
    color: #E87722;
  }

  .sams-header-wa-btn {
    display: none;
    align-items: center;
    gap: 6px;
    background: rgba(37, 211, 102, 0.12);
    color: #128C7E;
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .sams-header-wa-btn:hover {
    background: #25D366;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .sams-header-cart-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #2B160E;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .sams-header-cart-btn:hover {
    background: rgba(43, 22, 14, 0.06);
    color: #E87722;
  }

  .sams-cart-count-badge {
    position: absolute;
    top: 4px;
    right: 2px;
    background: #E87722;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    line-height: 18px;
    border-radius: 9px;
    text-align: center;
    padding: 0 4px;
  }

  .sams-mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #2B160E;
    cursor: pointer;
    padding: 6px;
  }

  .sams-desktop-nav {
    display: block;
  }

  /* Mobile drawer */
  .sams-mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
  }

  .sams-mobile-drawer.is-active {
    display: block;
  }

  .sams-mobile-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(2px);
  }

  .sams-mobile-drawer__content {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 82%;
    max-width: 320px;
    background: #FAF4EA;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 20px rgba(0,0,0,0.15);
    animation: samsSlideIn 0.25s ease-out;
  }

  @keyframes samsSlideIn {
    from { transform: translateX(-100%); }
    to { transform: translateX(0); }
  }

  .sams-mobile-nav-link {
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #2B160E;
    text-decoration: none;
    padding: 6px 0;
  }

  @media (max-width: 860px) {
    .sams-desktop-nav {
      display: none !important;
    }
    .sams-mobile-toggle {
      display: inline-flex !important;
    }
  }

  @media (min-width: 1024px) {
    .sams-header-wa-btn {
      display: inline-flex !important;
    }
  }
</style>

<script>
  (function() {
    const btn = document.getElementById('sams-mobile-menu-btn');
    const drawer = document.getElementById('sams-mobile-drawer');
    const closeBtn = document.getElementById('sams-drawer-close');
    const overlay = document.getElementById('sams-drawer-overlay');

    if (btn && drawer) {
      btn.addEventListener('click', () => {
        drawer.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeDrawer() {
      if (drawer) {
        drawer.classList.remove('is-active');
        document.body.style.overflow = '';
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);
  })();
</script>

{% schema %}
{
  "name": "Sams Header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF4EA"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#EADBCA"
    }
  ],
  "presets": [
    {
      "name": "Sams Header"
    }
  ]
}
{% endschema %}
