    {
      "type": "range",
      "id": "body_weight",
      "min": 100, "max": 900, "step": 100,
      "label": "Font Weight",
      "default": 400
    },
    {
      "type": "header",
      "content": "Heading 1 (H1)"
    },
    {
      "type": "range",
      "id": "h1_size",
      "min": 10, "max": 100, "step": 1, "unit": "px",
      "label": "H1 Font Size",
