          "default": "Shelf-stable"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "View Spreads"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sams Category Tiles",
      "blocks": [
        {
