</section>

<script>
  // Variant switcher & image gallery interactions
  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('SamsMainImage');
    const thumbBtns = document.querySelectorAll('.sams-thumb-btn');
    const variantPills = document.querySelectorAll('.sams-variant-pill');
    const priceDisplay = document.getElementById('SamsProductPrice');
    const variantInput = document.getElementById('SamsVariantId');
    const stickyVariantInput = document.querySelector('.sams-sticky-variant-id');
    const waBtn = document.getElementById('SamsWhatsAppOrderBtn');
    const productTitle = {{ product.title | json }};

    // Thumbnail click
    thumbBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        thumbBtns.forEach(b => {
          b.classList.remove('active');
          b.style.borderColor = 'transparent';
        });
        btn.classList.add('active');
        btn.style.borderColor = 'var(--gold)';
        if (mainImg) mainImg.src = btn.dataset.imageSrc;
      });
    });

    // Variant pills
    variantPills.forEach(pill => {
      pill.addEventListener('click', () => {
        variantPills.forEach(p => {
          p.classList.remove('active');
          p.style.background = '#FFFFFF';
          p.style.color = 'var(--espresso)';
          p.style.borderColor = 'var(--line)';
        });
        pill.classList.add('active');
        pill.style.background = 'var(--espresso)';
        pill.style.color = 'var(--ivory)';
        pill.style.borderColor = 'var(--espresso)';

        const newId = pill.dataset.variantId;
        const newPrice = pill.dataset.variantPrice;
        if (variantInput) variantInput.value = newId;
        if (stickyVariantInput) stickyVariantInput.value = newId;
        if (priceDisplay) priceDisplay.innerText = newPrice;

        // Update WhatsApp text
        if (waBtn) {
          const text = encodeURIComponent(`Hi Sam's Food! I would like to order: ${productTitle} (${pill.innerText.trim()})`);
          waBtn.href = `https://wa.me/923454788888?text=${text}`;
        }
      });
    });
  });
</script>

