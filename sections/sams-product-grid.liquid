{%- comment -%}
  Sam's Food - Editorial Product Grid Section
  Supports collection picker, custom limits, and uses sams-product-card snippet
{%- endcomment -%}

<section
  class="sams-product-grid-section"
  style="padding-block-start: min({{ section.settings.pad_top }}px, 11vw); padding-block-end: min({{ section.settings.pad_bottom }}px, 11vw); background: {{ section.settings.bg_color }};"
>
  <div class="page-width" style="max-width: 1240px; margin: 0 auto; padding-inline: 20px;">
    <!-- Section Header -->
    <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: clamp(24px, 5vw, 40px);" class="sams-fade-up">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="sams-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 style="font-size: clamp(2rem, 3.2vw, 2.7rem); margin: 0 0 8px; color: var(--espresso); font-family: var(--font-editorial);">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p style="font-size: 1rem; color: var(--muted); margin: 0; font-family: var(--font-clean);">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.view_all_link != blank -%}
        <div>
          <a href="{{ section.settings.view_all_link }}" class="sams-btn-secondary" style="padding: 10px 22px; font-size: 13px;">
            {{ section.settings.view_all_label | default: 'View All' }}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Products Grid -->
    {%- assign selected_collection = collections[section.settings.collection] | default: collections.all -%}

    <div
      class="sams-grid"
      style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;"
    >
      {%- if selected_collection != blank and selected_collection.products.size > 0 -%}
        {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
          <div class="sams-fade-up" style="display: flex;">
            {% render 'sams-product-card', product: product, show_quick_add: true %}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Demo Preview if no collection products created yet -->
        {%- for i in (1..4) -%}
          <div class="sams-card sams-fade-up" style="padding: 24px; text-align: center; background: #FFFFFF;">
            <div style="aspect-ratio: 1/1; background: var(--sesame); border-radius: var(--radius-inner); margin-bottom: 16px; display: flex; align-items: center; justify-content: center;">
              <span style="font-family: var(--font-editorial); color: var(--gold); font-size: 1.1rem; font-style: italic;">
                {%- case i -%}
                  {%- when 1 -%}Sam's Tahina 600g
                  {%- when 2 -%}Pomegranate Molasses
                  {%- when 3 -%}Sam's Falafel 16pcs
                  {%- when 4 -%}Multigrain Flour 5kg
                {%- endcase -%}
              </span>
            </div>
            <h4 style="font-family: var(--font-editorial); font-size: 1.15rem; margin: 0 0 6px;">
              {%- case i -%}
                {%- when 1 -%}Sam's Tahina
                {%- when 2 -%}Pomegranate Molasses
                {%- when 3 -%}Sam's Falafel
                {%- when 4 -%}Stone Ground Flour
              {%- endcase -%}
            </h4>
            <div style="font-weight: 700; color: var(--espresso); margin-bottom: 14px;">
              {%- case i -%}
                {%- when 1 -%}Rs 1,090
                {%- when 2 -%}Rs 2,800
                {%- when 3 -%}Rs 770
                {%- when 4 -%}Rs 2,100
              {%- endcase -%}
            </div>
            <a href="/collections/all" class="sams-btn-primary" style="width: 100%; font-size: 12px; padding: 9px 16px;">
              View Details
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sams Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LAHORI KITCHEN FAVORITES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most loved artisan Middle Eastern pantry staples."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "View All Pantry"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF6EE"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding Top",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding Bottom",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Sams Product Grid"
    }
  ]
}
{% endschema %}
