{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.section_bg_color }};
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .section-{{ section.id }} {
    --card-bg: {{ section.settings.card_bg_color }};
    --text-color: {{ section.settings.text_color }};
    --subtext-color: {{ section.settings.subtext_color }};
    --icon-bg: {{ section.settings.icon_bg_color }};
    --icon-color: {{ section.settings.icon_arrow_color }};
    --icon-hover-bg: {{ section.settings.icon_hover_bg }};
    --icon-hover-color: {{ section.settings.icon_hover_color }};
    --image-radius: {{ section.settings.image_radius }}px;
    --desktop-columns: {{ section.settings.desktop_columns }};
    --gap: {{ section.settings.grid_gap }}px;
  }

  /* Core Layout */
  .modern-collections {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .modern-collections__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_margin }}px;
  }

  .modern-collections__header h2 {
    font-size: {{ section.settings.heading_size_mobile }}px;
    color: var(--text-color);
    margin: 0;
    font-weight: 500;
    line-height: 1.2;
  }

  @media screen and (min-width: 769px) {
    .modern-collections__header h2 {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  /* Grid & Slider Logic */
  .modern-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--desktop-columns), 1fr);
    gap: var(--gap);
  }

  @media screen and (max-width: 768px) {
    {% if section.settings.mobile_layout == 'slider' %}
      .modern-collections__grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
        margin-left: -20px;
        margin-right: -20px;
        padding-left: 20px;
        padding-right: 20px;
      }
      .modern-collections__grid::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
      }
      .modern-collections__card {
        flex: 0 0 {{ section.settings.mobile_card_width }}%;
        scroll-snap-align: start;
      }
    {% else %}
      .modern-collections__grid {
        grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      }
    {% endif %}
  }

  /* Card Styling */
  .modern-collections__card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    group; /* For hover context */
  }

  .modern-collections__image-wrapper {
    background-color: var(--card-bg);
    border-radius: var(--image-radius);
    overflow: hidden;
    position: relative;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0; /* Removed padding so image goes edge-to-edge */
  }

  .modern-collections__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Changed to cover to fill the whole box */
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1); /* Buttery smooth image zoom */
  }

  .modern-collections__info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .modern-collections__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .modern-collections__title {
    font-size: {{ section.settings.title_size }}px;
    color: var(--text-color);
    font-weight: 600; /* Made slightly bolder based on your screenshot */
    margin: 0;
  }

  .modern-collections__count {
    font-size: {{ section.settings.subtext_size }}px;
    color: var(--subtext-color);
    margin: 0;
  }

  /* Icon Button */
  .modern-collections__icon {
    width: 48px; /* Slightly larger based on screenshot proportion */
    height: 48px;
    border-radius: 50%;
    background-color: var(--icon-bg);
    color: var(--icon-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.5s ease, color 0.5s ease;
    flex-shrink: 0;
  }

  .modern-collections__icon svg {
    width: 16px;
    height: 16px;
    transition: transform 0.5s ease; /* Slower, smoother rotation */
    transform-origin: center;
  }

  /* Hover Effects (Desktop Only usually) */
  @media (hover: hover) {
    .modern-collections__card:hover .modern-collections__image-wrapper img {
      transform: scale(1.05); /* Softer scale effect since it's full bleed now */
    }
    
    .modern-collections__card:hover .modern-collections__icon {
      background-color: var(--icon-hover-bg);
      color: var(--icon-hover-color);
    }

    .modern-collections__card:hover .modern-collections__icon svg {
      transform: rotate(45deg); /* Rotates exactly 45 degrees to the right */
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} section-{{ section.id }}-padding modern-collections">
  {%- if section.settings.heading != blank -%}
    <div class="modern-collections__header">
      <h2>{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="modern-collections__grid">
    {%- for collection in collections -%}
      {%- liquid
        assign title = collection.title
        assign items_text = collection.all_products_count | append: ' items'
        assign image = collection.image | default: collection.products.first.featured_image
      -%}

      <a href="{{ collection.url | default: '#' }}" class="modern-collections__card">
        <div class="modern-collections__image-wrapper">
          {%- if image != blank -%}
            {{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: title }}
          {%- else -%}
            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="modern-collections__info">
          <div class="modern-collections__text">
            <h3 class="modern-collections__title">{{ title }}</h3>
            <p class="modern-collections__count">{{ items_text }}</p>
          </div>
          
          <div class="modern-collections__icon">
            <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 13L13 1M13 1H4.6M13 1V9.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Modern Collections Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1400
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 20, "max": 80, "step": 2, "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16, "max": 50, "step": 2, "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_margin",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Space below heading",
      "default": 50
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2, "max": 6, "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10, "max": 60, "step": 2, "unit": "px",
      "label": "Gap between cards",
      "default": 24
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        { "value": "grid", "label": "Grid (Stacked)" },
        { "value": "slider", "label": "Horizontal Swipe" }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Grid Columns (If Grid Selected)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 40, "max": 100, "step": 5, "unit": "%",
      "label": "Mobile Card Width (If Swipe Selected)",
      "default": 80
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Shape (Aspect Ratio)",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Tall (3:4)" },
        { "value": "16 / 9", "label": "Landscape (16:9)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0, "max": 50, "step": 2, "unit": "px",
      "label": "Image Corner Radius",
      "default": 24
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Image Background Color",
      "default": "#f6f6f6"
    },
    {
      "type": "header",
      "content": "Typography & Colors"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14, "max": 40, "step": 1, "unit": "px",
      "label": "Collection Title Size",
      "default": 24
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "subtext_size",
      "min": 10, "max": 24, "step": 1, "unit": "px",
      "label": "Items Count Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Items Count Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Arrow Button Settings"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Button Background (Normal)",
      "default": "#EAEAEA"
    },
    {
      "type": "color",
      "id": "icon_arrow_color",
      "label": "Arrow Color (Normal)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_hover_bg",
      "label": "Button Background (Hover)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Arrow Color (Hover)",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Modern Collections Grid"
    }
  ]
}
{% endschema %}