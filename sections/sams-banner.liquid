{%- comment -%}
  Sam's Food - Wholesale & Restaurant CTA Banner
  Light sand card on the page background with gold accents and direct WhatsApp trade inquiry
{%- endcomment -%}

<section
  class="sams-banner-section"
  style="--sams-banner-bg: {{ section.settings.bg_color }}; --sams-banner-card: {{ section.settings.card_color }}; --sams-banner-text: {{ section.settings.text_color }}; padding-block-start: min({{ section.settings.pad_top }}px, 11vw); padding-block-end: min({{ section.settings.pad_bottom }}px, 11vw);"
>
  <div class="sams-banner__wrap">
    <div class="sams-banner__card sams-fade-up">
      <div class="sams-banner__ring" aria-hidden="true"></div>

      <div class="sams-banner__copy">
        <span class="sams-eyebrow sams-banner__eyebrow">{{ section.settings.eyebrow }}</span>

        <h2 class="sams-banner__heading">
          {{ section.settings.heading }}
        </h2>

        <p class="sams-banner__text">
          {{ section.settings.subheading }}
        </p>
      </div>

      <div class="sams-banner__actions">
        {%- capture wa_trade_msg -%}Hi Sams Food, we are interested in wholesale commercial bulk supply for our business.{%- endcapture -%}
        <a
          href="https://wa.me/923454788888?text={{ wa_trade_msg | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          class="sams-btn-primary"
          style="padding: 16px 32px; font-size: 14px;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.13c-.25.7-1.45 1.34-2 1.43-.52.08-1.18.11-1.9-.12-.44-.14-1-.32-1.73-.64-3.04-1.31-5.03-4.37-5.18-4.57-.15-.2-1.24-1.65-1.24-3.15 0-1.5.78-2.23 1.06-2.54.28-.31.6-.38.8-.38.2 0 .4 0 .58.01.19.01.44-.07.69.53.25.6.85 2.08.93 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.39-.45.52-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.03 1.12 1 2.07 1.31 2.36 1.46.3.15.47.13.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.73.82 2.02.97.3.15.5.22.57.35.08.12.08.72-.17 1.42z"/></svg>
          {{ section.settings.button_label }}
        </a>

        <a href="/collections/bulk-wholesale" class="sams-banner__link">
          View Bulk Pack Sizes (3kg & 14kg)
        </a>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .sams-banner-section {
    background: var(--sams-banner-bg, var(--ivory));
    color: var(--sams-banner-text, var(--espresso));
  }

  .sams-banner__wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: 20px;
  }

  .sams-banner__card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 28px 40px;
    padding: 40px 24px;
    background: var(--sams-banner-card, var(--sesame));
    border: 1px solid rgba(168, 123, 50, 0.22);
    border-radius: var(--radius-card);

    @media screen and (min-width: 750px) {
      padding: 56px 56px;
    }
  }

  .sams-banner__ring {
    position: absolute;
    right: -90px;
    bottom: -90px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    border: 1px solid rgba(168, 123, 50, 0.25);
    pointer-events: none;
  }

  .sams-banner__copy,
  .sams-banner__actions {
    position: relative;
    z-index: 1;
  }

  .sams-banner__copy {
    flex: 1 1 460px;
    max-width: 620px;
  }

  .sams-banner-section .sams-banner__eyebrow {
    color: var(--gold);
  }

  .sams-banner-section .sams-banner__heading {
    margin: 0 0 14px;
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 3.2vw, 2.6rem);
    line-height: 1.15;
    color: var(--sams-banner-text, var(--espresso));
  }

  .sams-banner__text {
    margin: 0;
    font-family: var(--font-clean);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .sams-banner__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sams-banner-section .sams-banner__link {
    text-align: center;
    font-family: var(--font-clean);
    font-size: 13px;
    color: var(--saffron-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sams-banner-section .sams-banner__link:hover {
    color: var(--espresso);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sams Wholesale Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COMMERCIAL & FOODSERVICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cafés & restaurants: bulk tahina and flour at trade prices."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Consistent quality for kitchens, bakeries, and caterers across Lahore and Pakistan. Custom bucket packaging (3kg & 14kg) with priority dispatch."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Chat on WhatsApp for Trade Rates"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FBF6EE"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card Background",
      "default": "#EEDFCA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#2B160E"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding Top",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding Bottom",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Sams Wholesale Banner"
    }
  ]
}
{% endschema %}
