{% assign store_gen = shop.metafields.kluck_ai.store_generation.value %}

{% comment %}
  Hero Peek Slider - Product Pro Version
{% endcomment %}

{% style %}


  #hs-{{ section.id }} {
    --font-h: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-b: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --slide-height-d: {{ section.settings.height_desktop }}px;
    --slide-height-m: {{ section.settings.height_mobile }}px;
    --slide-radius: {{ section.settings.border_radius }}px;
    --zoom-speed: {{ section.settings.zoom_duration }}s;
    --pt: {{ section.settings.padding_top }}px;
    --center-width: 100%; 
    --gap: 0px;
  }
{% endstyle %}

<style>
  #hs-{{ section.id }} .hs-section {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding-top: var(--pt);
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  #hs-{{ section.id }} .hs-track-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  #hs-{{ section.id }} .hs-slide {
    position: absolute;
    top: 0;
    width: var(--center-width);
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.3, 1), opacity 0.6s ease;
    opacity: 0; 
    z-index: 1;
  }

  #hs-{{ section.id }} .hs-bg-wrap {
    width: 100%; height: 100%; 
    position: relative;
    border-radius: var(--slide-radius);
    overflow: hidden;
  }
  #hs-{{ section.id }} .hs-bg-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(1.15);
  }
  #hs-{{ section.id }} .hs-slide.active .hs-bg-img {
    animation: hsZoomOut var(--zoom-speed) ease-out forwards;
  }
  @keyframes hsZoomOut {
    from { transform: scale(1.15); }
    to { transform: scale(1); }
  }

  #hs-{{ section.id }} .hs-slide.active { opacity: 1; transform: translateX(0); z-index: 5; }
  #hs-{{ section.id }} .hs-slide.prev { opacity: 1; transform: translateX(calc(-100% - var(--gap))); z-index: 2; cursor: pointer; }
  #hs-{{ section.id }} .hs-slide.next { opacity: 1; transform: translateX(calc(100% + var(--gap))); z-index: 2; cursor: pointer; }

  #hs-{{ section.id }} .hs-content-box {
    position: absolute;
    inset: 0;
    padding: 40px 8%;
    display: flex;
    flex-direction: column;
    z-index: 3;
    transition: opacity 0.5s ease 0.3s;
    opacity: 0;
  }
  #hs-{{ section.id }} .hs-slide.active .hs-content-box { opacity: 1; }

  #hs-{{ section.id }} .hs-eyebrow {
    font-family: var(--font-b);
    color: #ffffff !important; /* Always white on desktop */
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
    display: block;
  }
  #hs-{{ section.id }} h2 {
    font-family: var(--font-h);
    color: #ffffff !important; /* Always white on desktop */
    margin: 0 0 25px 0;
    line-height: 1.1;
  }

  /* PRODUCT PILL STYLE */
  #hs-{{ section.id }} .hs-product-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    background: rgba(255, 255, 255, 0.05); /* Adjusted to match white text context */
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 100px;
    margin-bottom: 20px;
    text-decoration: none;
    color: #ffffff !important;
    transition: transform 0.3s ease;
  }
  #hs-{{ section.id }} .hs-product-pill:hover { transform: translateY(-3px); }
  #hs-{{ section.id }} .hs-product-pill img {
    width: 40px; height: 40px; border-radius: 50%; object-fit: cover;
  }
  #hs-{{ section.id }} .hs-product-pill span { font-size: 14px; font-weight: 500; font-family: var(--font-b); }

  #hs-{{ section.id }} .hs-btn {
    position: relative;
    display: inline-block;
    padding: 15px 40px;
    border-radius: 50px;
    font-family: var(--font-b);
    font-weight: 500;
    text-decoration: none;
    color: black; /* required for blend */
    z-index: 1;
    overflow: hidden;
    transition: transform 0.2s ease, opacity 0.2s ease;
    mix-blend-mode: screen; /* Creates the cut-out effect on desktop */
  }

  /* White button layer */
  #hs-{{ section.id }} .hs-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #ffffff;
    border-radius: 50px;
    z-index: -1;
  }
  #hs-{{ section.id }} .hs-btn:hover { transform: translateY(-2px); opacity: 0.9; }

  #hs-{{ section.id }} .hs-pagination {
    display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 30px;
    padding-bottom: 30px; 
  }
  #hs-{{ section.id }} .hs-dot {
    width: 10px; height: 10px; 
    border-radius: 50%; 
    cursor: pointer; 
    position: relative; 
    overflow: hidden; 
  }
  #hs-{{ section.id }} .hs-dot::before {
    content: "";
    position: absolute; inset: 0;
    background-color: currentColor;
    opacity: 0.25;
  }
  #hs-{{ section.id }} .hs-dot.active { width: 40px; border-radius: 10px; transition: width 0.4s ease;}
  #hs-{{ section.id }} .hs-progress {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 0%; 
    background-color: currentColor;
    z-index: 2;
  }
  #hs-{{ section.id }} .hs-dot.filling .hs-progress {
    width: 100% !important;
    transition: width {{ section.settings.autoplay_speed }}ms linear !important;
  }

  @media (max-width: 768px) {
    #hs-{{ section.id }} .hs-track-wrapper { 
      height: auto; 
      display: block; 
      aspect-ratio: auto !important; /* Allow track to expand vertically */
    }
    #hs-{{ section.id }} .hs-slide { 
      position: relative; 
      width: 100%; 
      height: auto !important; /* Allow slide to wrap both image and text */
      display: none; 
      transform: none !important; 
      opacity: 1;
    }
    #hs-{{ section.id }} .hs-slide.active { display: block; }
    #hs-{{ section.id }} .hs-bg-wrap { aspect-ratio: 1 / 1; height: auto; }
    #hs-{{ section.id }} .hs-bg-img {
  object-position: right center;
}
    #hs-{{ section.id }} .hs-content-box { 
      position: relative; opacity: 1; padding: 30px 20px 10px;
      inset: auto; align-items: center !important; text-align: center !important;
      background-color: var(--color-background) !important;
    }
    
    /* Force completely centered layout on mobile */
    #hs-{{ section.id }} .hs-text-content-inner {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      background: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      width: 100% !important;
    }

    #hs-{{ section.id }} h2 { 
      font-size: 32px !important; 
      color: #000000 !important; /* Always black on mobile */
      text-align: center !important;
    }
    #hs-{{ section.id }} .hs-eyebrow {
      color: #000000 !important; /* Always black on mobile */
      text-align: center !important;
    }
    #hs-{{ section.id }} .hs-product-pill { 
      margin-left: auto !important; 
      margin-right: auto !important; 
      color: #000000 !important; /* Always black on mobile */
      border-color: rgba(0, 0, 0, 0.1);
      background: rgba(0, 0, 0, 0.05);
    }

    /* Convert overlay button to a solid background text button on mobile and center it */
    #hs-{{ section.id }} .hs-btn {
      mix-blend-mode: normal !important;
      background: #000000 !important;
      color: #ffffff !important;
      margin: 10px auto 0 !important;
      text-align: center !important;
    }
    #hs-{{ section.id }} .hs-btn::before {
      display: none !important;
    }
  }
</style>

{% if shop.metafields.app.block_control.value %}

<div id="hs-{{ section.id }}" class="color-{{ section.settings.color_scheme }}">
  <div class="hs-section">
    <div class="hs-track-wrapper" id="hs-track-{{ section.id }}">
{%- assign total_blocks = section.blocks.size -%}

{% for block in section.blocks %}
  {%- comment -%} Determine which metafield keys to use based on block count {%- endcomment -%}
  {%- if total_blocks == 1 -%}
    {%- assign kluck_banner_image = shop.metafields.kluck_ai.banner_image.value -%}
    {%- assign kluck_banner_heading = store_gen.home_page.text.banner_heading -%}
    {%- assign kluck_banner_eyebrow = store_gen.home_page.text.banner_eyebrow -%}
    {%- assign kluck_product_handle = store_gen.home_page.text.selected_product -%}
  {%- else -%}
    {%- assign i = forloop.index -%}
    {%- assign img_key = 'banner_image_' | append: i -%}
    {%- assign heading_key = 'banner_heading_' | append: i -%}
    {%- assign eyebrow_key = 'banner_eyebrow_' | append: i -%}
    {%- assign product_key = 'selected_product_' | append: i -%}

    {%- assign kluck_banner_image = shop.metafields.kluck_ai[img_key].value -%}
    {%- assign kluck_banner_heading = store_gen.home_page.text[heading_key] -%}
    {%- assign kluck_banner_eyebrow = store_gen.home_page.text[eyebrow_key] -%}
    {%- assign kluck_product_handle = store_gen.home_page.text[product_key] -%}
  {%- endif -%}

  {%- comment -%} Logic for Product Object {%- endcomment -%}
  {%- assign selected_product = block.settings.product -%}
  {%- if section.settings.use_kluck_ai_metafields and kluck_product_handle != blank -%}
     {%- assign selected_product = all_products[kluck_product_handle] -%}
  {%- endif -%}

  <div class="hs-slide {% if forloop.first %}active{% endif %}" 
       onclick="if(!this.classList.contains('active')) window['hsGoToSlide_{{ section.id }}']({{ forloop.index0 }})"
       {{ block.shopify_attributes }}>
    
    {%- style -%}
      #hs-{{ section.id }} [data-block-id="{{ block.id }}"] { justify-content: {{ block.settings.v_align }}; align-items: {{ block.settings.h_align }}; }
      #hs-{{ section.id }} [data-block-id="{{ block.id }}"] .hs-text-content-inner { max-width: {{ block.settings.content_max_width }}px; width: 100%; text-align: {{ block.settings.text_align }}; }
      #hs-{{ section.id }} [data-block-id="{{ block.id }}"] .hs-btn {
        {% if block.settings.text_align == 'right' %} margin-left: auto; margin-right: 0; {% elsif block.settings.text_align == 'center' %} margin-left: auto; margin-right: auto; {% else %} margin-left: 0; margin-right: auto; {% endif %}
      }
      #hs-{{ section.id }} [data-block-id="{{ block.id }}"] h2 { font-size: {{ block.settings.h_size }}px; font-weight: {{ block.settings.h_weight }}; }
      #hs-{{ section.id }} [data-block-id="{{ block.id }}"] .hs-eyebrow { font-size: {{ block.settings.e_size }}px; }
    {%- endstyle -%}

    <div class="hs-bg-wrap">
      {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 2000 }}" class="hs-bg-img" alt="{{ block.settings.heading | escape }}">
      {% elsif section.settings.use_kluck_ai_metafields and kluck_banner_image != blank %}
          <img src="{{ kluck_banner_image | image_url: width: 2000 }}" class="hs-bg-img" alt="{{ kluck_banner_heading | escape }}">
      {% else %}
          <div class="hs-bg-img" style="background: #e5c3b1;"></div>
      {% endif %}
      <div class="hs-overlay" style="position:absolute; inset:0; background: rgba(0,0,0,{{ block.settings.overlay | divided_by: 100.0 }});"></div>
    </div>

    <div class="hs-content-box color-{{ block.settings.slide_color_scheme }}" data-block-id="{{ block.id }}" style="background-color: transparent !important;">
      <div class="hs-text-content-inner">

        {% if section.settings.use_kluck_ai_metafields and kluck_banner_eyebrow != blank %}
            <span class="hs-eyebrow">{{ kluck_banner_eyebrow }}</span>
        {% elsif block.settings.eyebrow != blank %}
            <span class="hs-eyebrow">{{ block.settings.eyebrow }}</span>
        {% endif %}

        <h2>
          {% if section.settings.use_kluck_ai_metafields and kluck_banner_heading != blank %}
            {{ kluck_banner_heading }}
          {% else %}
            {{ block.settings.heading }}
          {% endif %}
        </h2>

        {% if selected_product != blank %}
          <a href="{{ selected_product.url }}" class="hs-btn">{{ block.settings.btn_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
{% endfor %}
    </div>

    <div class="hs-pagination">
      {% for block in section.blocks %}
        <div class="hs-dot {% if forloop.first %}active{% endif %}" onclick="window['hsGoToSlide_{{ section.id }}']({{ forloop.index0 }})">
          <div class="hs-progress"></div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function(){
    const sectionId = "{{ section.id }}";
    const slides = document.querySelectorAll(`#hs-${sectionId} .hs-slide`);
    const dots = document.querySelectorAll(`#hs-${sectionId} .hs-dot`);
    const duration = {{ section.settings.autoplay_speed }};
    let currentIndex = 0;
    let timer;

    function updateSlides(index) {
      if(index < 0) index = slides.length - 1;
      if(index >= slides.length) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        slide.classList.remove('active', 'prev', 'next');
        if (i === index) slide.classList.add('active');
        else if (i === (index - 1 + slides.length) % slides.length) slide.classList.add('prev');
        else if (i === (index + 1) % slides.length) slide.classList.add('next');
      });

      dots.forEach((dot, i) => {
        const progress = dot.querySelector('.hs-progress');
        if (i !== index) {
          dot.classList.remove('active', 'filling');
          progress.style.transition = 'none';
          progress.style.width = '0%';
        }
      });

      const activeDot = dots[index];
      if (activeDot) {
        const progress = activeDot.querySelector('.hs-progress');
        activeDot.classList.add('active');
        progress.style.transition = 'none';
        progress.style.width = '0%';
        void progress.offsetWidth; 
        setTimeout(() => { activeDot.classList.add('filling'); }, 20);
      }

      clearTimeout(timer);
      if(duration > 0) timer = setTimeout(() => updateSlides(currentIndex + 1), duration);
    }
    window[`hsGoToSlide_${sectionId}`] = function(idx) { updateSlides(idx); };
    updateSlides(0);
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Hero Pro Slider",
  "settings": [
    { "type": "checkbox", "id": "use_kluck_ai_metafields", "label": "Use Kluck AI metafields", "default": true },
    { "type": "header", "content": "Layout Settings" },
    { "type": "range", "id": "height_desktop", "min": 400, "max": 900, "step": 10, "default": 600, "label": "Desktop Height" },
    { "type": "range", "id": "height_mobile", "min": 250, "max": 600, "step": 10, "default": 400, "label": "Mobile Image Height" },
    { "type": "range", "id": "border_radius", "min": 0, "max": 60, "default": 30, "label": "Slide Corner Radius" },
    { "type": "header", "content": "Animation Speed" },
    { "type": "range", "id": "autoplay_speed", "min": 0, "max": 9000, "step": 500, "default": 6000, "unit": "ms", "label": "Autoplay (0 = off)" },
    { "type": "range", "id": "zoom_duration", "min": 2, "max": 20, "step": 1, "default": 8, "unit": "s", "label": "Image Zoom Duration" },
    { "type": "header", "content": "Color Schemes" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Section Color Scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "default": 0, "label": "Section Top Padding" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "default": 0, "label": "Image Overlay Darkener" },
        { "type": "product", "id": "product", "label": "Select Product", "info": "Shows thumbnail and title at bottom." },
        { "type": "header", "content": "Slide Scheme" },
        { "type": "color_scheme", "id": "slide_color_scheme", "label": "Text & Button Color Scheme", "default": "scheme-2" },
        { "type": "header", "content": "Text Content" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Edition" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collection" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Shop Product" },
        { "type": "header", "content": "Slide Specific Styling" },
        { "type": "range", "id": "h_size", "min": 30, "max": 100, "default": 64, "label": "Heading Font Size" },
        { "type": "select", "id": "h_weight", "label": "Heading Weight", "default": "500", "options": [
            {"value": "400", "label": "Normal"}, {"value": "500", "label": "Medium"}, {"value": "600", "label": "Bold"}
          ]
        },
        { "type": "range", "id": "content_max_width", "min": 300, "max": 1000, "step": 10, "default": 600, "label": "Content Box Max-Width (px)" },
        { "type": "range", "id": "e_size", "min": 12, "max": 24, "default": 16, "label": "Eyebrow Font Size" },
        { "type": "header", "content": "Alignment (Desktop Only)" },
        { "type": "select", "id": "h_align", "label": "Horizontal Position (Slide)", "default": "center", "options": [
            {"value": "flex-start", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "flex-end", "label": "Right"}
          ]
        },
        { "type": "select", "id": "v_align", "label": "Vertical Position (Slide)", "default": "center", "options": [
            {"value": "flex-start", "label": "Top"}, {"value": "center", "label": "Middle"}, {"value": "flex-end", "label": "Bottom"}
          ]
        },
        { "type": "select", "id": "text_align", "label": "Inner Text Alignment", "default": "center", "options": [
            {"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}
          ]
        }
      ]
    }
  ],
  "presets": [
    { "name": "Hero Pro Slider", "blocks": [ {"type": "slide"}, {"type": "slide"} ] }
  ]
}
{% endschema %}