{% doc %}
  Product type label above the product title (Lumenook port, Sam's Food styling).
{% enddoc %}

{%- assign product_type = closest.product.type -%}
{%- if product_type != blank -%}
  <p class="sams-product-type" {{ block.shopify_attributes }}>{{ product_type }}</p>
{%- endif -%}

{% stylesheet %}
  .sams-product-type {
    grid-column: 1 / -1;
    order: -1;
    margin: 0;
    font-family: var(--font-clean);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sam's product type",
  "tag": null,
  "settings": [],
  "presets": [{ "name": "Sam's product type" }]
}
{% endschema %}
