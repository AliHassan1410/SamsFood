{%- doc -%}
  Floating WhatsApp button

  Fixed bottom-right link to the Sam's Food WhatsApp line. Rendered once from layout/theme.liquid.

  Colors: uses the theme's own color tokens so it follows the merchant palette.

  @example
  {% render 'sams-whatsapp' %}
{%- enddoc -%}

{% stylesheet %}
  .sams-whatsapp {
    position: fixed;
    inset-block-end: max(16px, env(safe-area-inset-bottom));
    inset-inline-end: 16px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-foreground);
    color: var(--color-background);
    box-shadow: 0 8px 24px rgb(var(--color-foreground-rgb) / 0.22);
    transition: transform 300ms ease, box-shadow 300ms ease;
  }

  .sams-whatsapp:hover {
    transform: scale(1.04);
  }

  .sams-whatsapp:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .sams-whatsapp svg {
    width: 28px;
    height: 28px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sams-whatsapp {
      transition: none;
    }

    .sams-whatsapp:hover {
      transform: none;
    }
  }
{% endstylesheet %}

<a
  class="sams-whatsapp"
  href="https://wa.me/923454788888"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Sam's Food on WhatsApp"
