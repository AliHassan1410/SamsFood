{%- doc -%}
  Sam's Food - Mobile Sticky Add-To-Cart Bar
  Visible when scrolling past the main buy button on mobile devices.
  @param product {Object} - Shopify product object
{%- enddoc -%}

<div class="sams-sticky-atc" aria-label="Quick Add to Cart Bar">
  <div style="max-width: 600px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 14px;">
    <!-- Left: Image + Info -->
    <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
      {%- if product.featured_image != blank -%}
        <div style="width: 44px; height: 44px; border-radius: 8px; overflow: hidden; background: var(--sesame); flex-shrink: 0;">
          <img
            src="{{ product.featured_image | image_url: width: 90 }}"
            alt="{{ product.title | escape }}"
            width="44"
            height="44"
            style="width: 100%; height: 100%; object-fit: cover;"
            loading="lazy"
          >
        </div>
      {%- endif -%}
      <div style="min-width: 0;">
        <div style="font-family: var(--font-clean); font-size: 13px; font-weight: 600; color: var(--espresso); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ product.title }}
        </div>
        <div style="font-size: 13px; font-weight: 700; color: var(--gold);">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>
      </div>
    </div>

    <!-- Right: Add to cart button -->
    <div>
      {%- if product.available -%}
        <form method="post" action="{{ routes.cart_add_url }}" style="margin: 0;">
          <input
            type="hidden"
            name="id"
            class="sams-sticky-variant-id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >
          <button
            type="submit"
            class="sams-btn-primary"
            style="padding: 10px 20px; font-size: 13px; white-space: nowrap;"
          >
            Add to Cart
          </button>
        </form>
      {%- else -%}
        <button
          disabled
          class="sams-btn-secondary"
          style="padding: 10px 18px; font-size: 12px; opacity: 0.6;"
        >
          Sold Out
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .sams-sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #FFFFFF;
    border-top: 1px solid var(--line);
    padding: 10px 16px;
    z-index: 99;
    box-shadow: 0 -4px 20px rgba(43, 22, 14, 0.08);
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sams-sticky-atc.visible {
    transform: translateY(0);
  }

  @media (min-width: 769px) {
    .sams-sticky-atc {
      display: none !important;
    }
  }
</style>
