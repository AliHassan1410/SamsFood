{%- doc -%}
  Sam's Food - Luxury Editorial Product Card
  @param product {Object} - Shopify Product object
{%- enddoc -%}

{%- liquid
  assign delivery_zone = product.metafields.custom.delivery_zone | default: 'nationwide'
  if product.tags contains 'lahore_only' or product.tags contains 'Lahore Only' or product.title contains 'Hummus' or product.title contains 'Falafel'
    assign delivery_zone = 'lahore_only'
  endif

  assign badges = product.metafields.custom.badges.value
  if badges == blank and product.metafields.custom.badges != blank
    assign badges = product.metafields.custom.badges | split: ','
  endif
  if badges == blank
    assign tag_badges = ''
    for tag in product.tags
      if tag contains 'badge:'
        assign tag_clean = tag | remove: 'badge:'
        assign tag_badges = tag_badges | append: tag_clean | append: ','
      endif
    endfor
    if tag_badges != blank
      assign badges = tag_badges | split: ','
    endif
  endif

  assign featured_image = product.featured_media | default: product.featured_image
  assign card_fallback_img = ''
  if featured_image == blank
    if product.handle contains 'falafel' or product.title contains 'Falafel'
      assign card_fallback_img = 'sams-falafel-box-front.jpg'
    elsif product.handle contains 'hummus' or product.title contains 'Hummus'
      assign card_fallback_img = 'sams-hummus-tub-open-front.jpg'
    elsif product.handle contains 'tahina' or product.title contains 'Tahina'
      if product.handle contains 'bulk' or product.handle contains 'bucket' or product.title contains 'Bucket' or product.title contains 'Bulk' or product.title contains 'Wholesale'
        assign card_fallback_img = 'sams-tahina-bucket-front.jpg'
      else
        assign card_fallback_img = 'sams-tahina-jar-front.jpg'
      endif
    elsif product.handle contains 'flour' or product.title contains 'Flour'
      assign card_fallback_img = 'sams-flour-5kg-field.jpg'
    endif
  endif
-%}

<div
  class="sams-product-card sams-card"
  style="display: flex; flex-direction: column; flex: 1 1 auto; min-inline-size: 0;"
  data-delivery-zone="{{ delivery_zone }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
>
  <div class="sams-card-media-wrap sams-media-zoom" style="position: relative; aspect-ratio: 1 / 1; background: var(--sesame); overflow: hidden;">
    {%- if featured_image != blank -%}
      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {{
          featured_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            widths: '300, 450, 600, 800',
            sizes: '(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw',
            alt: product.title,
            style: 'width: 100%; height: 100%; object-fit: cover; display: block;'
        }}
      </a>
    {%- elsif card_fallback_img != blank -%}
      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        <img
          src="{{ card_fallback_img | asset_url }}"
          alt="{{ product.title | escape }}"
          loading="lazy"
          width="800"
          height="800"
          style="width: 100%; height: 100%; object-fit: cover; display: block;"
        >
      </a>
    {%- else -%}
      <a href="{{ product.url }}" style="display: flex; align-items: center; justify-content: center; height: 100%; text-decoration: none; color: var(--gold);">
        <div style="text-align: center; padding: 20px;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 8px;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <div style="font-family: var(--font-clean); font-size: 13px; font-weight: 500; color: var(--espresso);">Sam's Kitchen</div>
        </div>
      </a>
    {%- endif -%}

    <!-- Floating Top Badges -->
    <div style="position: absolute; top: 12px; inset-inline-start: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2;">
      {%- if delivery_zone == 'lahore_only' -%}
        <span class="sams-badge sams-badge--lahore-only sams-badge--delivery">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 3px;"><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          Lahore Only
        </span>
      {%- else -%}
        <span class="sams-badge sams-badge--nationwide sams-badge--delivery">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 3px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Nationwide
        </span>
      {%- endif -%}
    </div>

    <!-- Quick WhatsApp Pill (Direct query) -->
    {%- capture wa_query -%}Hi Sams Food! I want to order {{ product.title }}{%- endcapture -%}
    <a
      href="https://wa.me/923454788888?text={{ wa_query | url_encode }}"
      target="_blank"
      rel="noopener noreferrer"
      class="sams-card-wa-icon"
      aria-label="Order {{ product.title }} on WhatsApp"
      style="position: absolute; bottom: 12px; inset-inline-end: 12px; width: 36px; height: 36px; border-radius: 50%; background: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(43,22,14,0.12); color: var(--olive); text-decoration: none; z-index: 2; transition: transform 0.25s ease;"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.13c-.25.7-1.45 1.34-2 1.43-.52.08-1.18.11-1.9-.12-.44-.14-1-.32-1.73-.64-3.04-1.31-5.03-4.37-5.18-4.57-.15-.2-1.24-1.65-1.24-3.15 0-1.5.78-2.23 1.06-2.54.28-.31.6-.38.8-.38.2 0 .4 0 .58.01.19.01.44-.07.69.53.25.6.85 2.08.93 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.39-.45.52-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.03 1.12 1 2.07 1.31 2.36 1.46.3.15.47.13.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.73.82 2.02.97.3.15.5.22.57.35.08.12.08.72-.17 1.42z"/></svg>
    </a>
  </div>

  <div class="sams-card-content" style="padding: 16px 18px 20px; display: flex; flex-direction: column; flex-grow: 1;">
    <!-- Badges Row -->
    {%- if badges != blank -%}
      <div style="margin-bottom: 8px;">
        {% render 'sams-badges', badges: badges %}
      </div>
    {%- endif -%}

    <!-- Title -->
    <h3 style="margin: 0 0 6px; font-size: 1.15rem; font-weight: 600; line-height: 1.3;">
      <a href="{{ product.url }}" style="color: var(--espresso); text-decoration: none; transition: color 0.2s ease;">
        {{ product.title }}
      </a>
    </h3>

    <!-- Optional Tagline / Short note -->
    {%- if product.metafields.custom.tagline != blank -%}
      <p style="margin: 0 0 10px; font-size: 0.85rem; color: var(--muted); font-style: italic; font-family: var(--font-editorial);">
        {{ product.metafields.custom.tagline }}
      </p>
    {%- endif -%}

    <!-- Price & Variants -->
    <div style="margin-top: auto; padding-top: 10px; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
      <div style="font-family: var(--font-clean); font-size: 1.1rem; font-weight: 700; color: var(--espresso);">
        {%- if product.price_varies -%}
          <span style="font-size: 0.85rem; font-weight: 400; color: var(--muted);">From </span>
        {%- endif -%}
        {{ product.price | money }}
      </div>

      {%- if product.variants.size > 1 -%}
        <div style="font-size: 0.75rem; color: var(--muted); background: var(--sesame); padding: 3px 8px; border-radius: var(--radius-pill); font-weight: 500;">
          {{ product.variants.size }} sizes
        </div>
      {%- endif -%}
    </div>

    <!-- Quick Action Button -->
    <div style="margin-top: 14px;">
      {%- if product.available -%}
        {%- if product.variants.size == 1 -%}
          <form method="post" action="{{ routes.cart_add_url }}" style="margin: 0;">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button
              type="submit"
              class="sams-btn-primary sams-product-atc"
              style="width: 100%; box-sizing: border-box; block-size: 44px; padding: 0 16px; font-size: 13px;"
            >
              Add to Cart
            </button>
          </form>
        {%- else -%}
          <a
            href="{{ product.url }}"
            class="sams-btn-secondary"
            style="width: 100%; box-sizing: border-box; block-size: 44px; padding: 0 16px; font-size: 13px; display: flex;"
          >
            Select Size
          </a>
        {%- endif -%}
      {%- else -%}
        <button
          type="button"
          disabled
          class="sams-btn-secondary"
          style="width: 100%; box-sizing: border-box; block-size: 44px; padding: 0 16px; font-size: 13px; opacity: 0.6; cursor: not-allowed;"
        >
          Sold Out
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
