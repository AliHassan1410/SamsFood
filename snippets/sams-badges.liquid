{%- doc -%}
  Renders luxury gold-outline badges for products or custom strings.
  @param badges {Array|String} - List of badges or comma-separated string
  @param class {String} - Optional extra class
{%- enddoc -%}

{%- liquid
  if badges != blank
    if badges.first
      assign badge_items = badges
    else
      assign badge_items = badges | split: ','
    endif
  endif
-%}

{%- if badge_items and badge_items.size > 0 -%}
  <div class="sams-badges-row {{ class }}" style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
    {%- for item in badge_items -%}
      {%- assign clean_item = item | strip -%}
      {%- if clean_item != blank -%}
        {%- assign item_down = clean_item | downcase -%}
        <span class="sams-badge {% if item_down contains 'halal' or item_down contains 'vegetarian' %}sams-badge--olive{% endif %}">
          {%- if item_down contains 'halal' -%}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {%- elsif item_down contains 'frozen' or item_down contains 'chilled' -%}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="2" x2="12" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line><line x1="19.07" y1="4.93" x2="4.93" y2="19.07"></line></svg>
          {%- endif -%}
          {{ clean_item }}
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
